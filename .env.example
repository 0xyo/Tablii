# Tablii environment variables
# Copy this file to .env and fill in values.

# Flask
FLASK_ENV=development
SECRET_KEY=
# Generate a strong random key: python -c 'import secrets; print(secrets.token_hex(32))'
# Database
DATABASE_URL=sqlite:///dev.db

# Payments (Flouci)
FLOUCI_APP_TOKEN=
FLOUCI_APP_SECRET=

# Optional demo bootstrap users
TABLII_SUPERADMIN_EMAIL=superadmin@tablii.com
TABLII_SUPERADMIN_PASSWORD=admin1234
TABLII_OWNER_EMAIL=owner@tablii.com
TABLII_OWNER_PASSWORD=owner1234
TABLII_RESTAURANT_NAME=Chez Ahmed
TABLII_RESTAURANT_SLUG=chez-ahmed
TABLII_RESTAURANT_CITY=Tunis
TABLII_RESTAURANT_ADDRESS=15 Rue de la Kasbah, Tunis
TABLII_RESTAURANT_PHONE=+21671000001
TABLII_STAFF_PASSWORD=staff1234
